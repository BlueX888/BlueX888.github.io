---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Analytics from '../components/Analytics.astro';
import { SITE } from '../site.config';

interface Props {
  title?: string;
  description?: string;
  /** 文章页传入，用于 og:type 与结构化数据 */
  article?: { date: Date; updated?: Date };
  reading?: boolean;
}
const { title, description = SITE.description, article, reading = false } = Astro.props;
const fullTitle = title ? `${title} · ${SITE.title}` : SITE.title;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang={SITE.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Serif+SC:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE.author} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={SITE.title} href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    {article && <meta property="article:published_time" content={article.date.toISOString()} />}
    {article?.updated && <meta property="article:modified_time" content={article.updated.toISOString()} />}
    <script is:inline>
      // 尽早应用主题，避免闪烁
      (function () {
        try {
          var t = localStorage.getItem('theme');
          if (t === 'dark' || t === 'light') document.documentElement.dataset.theme = t;
        } catch {}
      })();
    </script>
    <Analytics />
  </head>
  <body>
    <a class="skip-link" href="#main">跳至内容</a>
    <Header />
    <main id="main" class:list={['wrap', { 'reading-wrap': reading }]} tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
