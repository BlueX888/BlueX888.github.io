---
import FormattedDate from './FormattedDate.astro';
import { SECTIONS } from '../site.config';
import { postTitle, postUrl, excerpt, updatedDate, type Post } from '../lib/posts';

interface Props { post: Post; showSection?: boolean }
const { post, showSection = true } = Astro.props;
const updated = updatedDate(post);
const summary = excerpt(post, 110);
---
<article class="card">
  <h3 class="card-title"><a href={postUrl(post)}>{postTitle(post)}</a></h3>
  <div class="card-meta">
    <span>发表于 <FormattedDate date={post.data.date} withYear /></span>
    {updated && <span>修订于 <FormattedDate date={updated} withYear /></span>}
    {showSection && <a href={`/${post.collection}/`}>{SECTIONS[post.collection].name}</a>}
    {post.data.draft && <span>草稿</span>}
  </div>
  {summary && <p class="card-excerpt">{summary}</p>}
  {post.data.tags.length > 0 && (
    <div class="tags card-tags">
      {post.data.tags.map((t) => <a class="tag" href={`/tags/${encodeURIComponent(t)}/`}>{t}</a>)}
    </div>
  )}
</article>
