---
import FormattedDate from './FormattedDate.astro';
import { ArrowUpRight } from '@lucide/astro';
import { SECTIONS } from '../site.config';
import { postTitle, postUrl, excerpt, type Post } from '../lib/posts';

interface Props { post: Post }
const { post } = Astro.props;
const summary = excerpt(post, 90);
---
<article class="card">
  <div class="card-meta">
    <a class="card-section" href={`/${post.collection}/`}>{SECTIONS[post.collection].name}</a>
    <span class="card-date"><FormattedDate date={post.data.date} withYear /></span>
    {post.data.draft && <span class="card-draft">草稿</span>}
  </div>
  <h3 class="card-title"><a href={postUrl(post)}>{postTitle(post)}</a></h3>
  {summary && <p class="card-excerpt">{summary}</p>}
  <p class="card-more"><a href={postUrl(post)} aria-label={`阅读全文：${postTitle(post)}`}>阅读全文 <ArrowUpRight size={18} aria-hidden="true" /></a></p>
</article>
