---
import { SITE } from '../site.config';
import Pageview from './Pageview.astro';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="wrap">
    <span class="footer-credit"><svg class="footer-mark" viewBox="16 2 174 174" width="24" height="24" aria-hidden="true" focusable="false"><use href="/favicon.svg#brand-mark" /></svg>© {year} {SITE.author}{SITE.subtitle && ` · ${SITE.subtitle}`}</span>
    <Pageview site />
    <span class="footer-links"><a href="/rss.xml">RSS 订阅</a><a href="/sitemap-index.xml">站点地图</a></span>
  </div>
</footer>
