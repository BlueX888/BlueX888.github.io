---
import '@waline/client/waline.css';
import { WALINE } from '../site.config';
const enabled = Boolean(WALINE.serverURL);
---
{enabled && (
  <section class="comments" id="comments">
    <div
      id="waline"
      data-server={WALINE.serverURL}
      data-path={Astro.url.pathname}
      data-meta={WALINE.meta.join(',')}
    ></div>
  </section>
)}
<script>
  import { init } from '@waline/client';

  const el = document.getElementById('waline');
  if (el) {
    init({
      el,
      serverURL: el.dataset.server!,
      path: el.dataset.path,
      lang: 'zh-CN',
      // 不用登录也能留言；昵称、邮箱都可留空，留空显示为「匿名」
      login: 'enable',
      meta: el.dataset.meta!.split(',') as ('nick' | 'mail' | 'link')[],
      requiredMeta: [],
      // 配色跟随站点 CSS 变量（见 global.css 的 .comments），不用 Waline 自己的深色模式
      dark: false,
      // 关掉用不到的功能，保持轻量
      // 阅读量统一由 Pageview.astro 统计，避免一次访问重复计数。
      pageview: false,
      comment: false,
      reaction: false,
      emoji: false,
      search: false,
      imageUploader: false,
      wordLimit: 2000,
      noCopyright: true,
    });
  }
</script>
