---
import { dateParts } from '../lib/dates';
interface Props { date: Date; withYear?: boolean }
const { date, withYear = false } = Astro.props;
const { year, month, day, hour, minute } = dateParts(date);
---
<time datetime={date.toISOString()}>{withYear ? `${year}-${month}-${day}` : `${month}-${day}`} {hour}:{minute}</time>
