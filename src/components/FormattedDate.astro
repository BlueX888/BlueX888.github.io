---
interface Props { date: Date; withYear?: boolean }
const { date, withYear = false } = Astro.props;
const y = date.getFullYear();
const m = String(date.getMonth() + 1).padStart(2, '0');
const d = String(date.getDate()).padStart(2, '0');
---
<time datetime={date.toISOString().slice(0, 10)}>{withYear ? `${y}-${m}-${d}` : `${m}-${d}`}</time>
