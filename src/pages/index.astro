---
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';
import ThoughtCard from '../components/ThoughtCard.astro';
import { ArrowUpRight } from '@lucide/astro';
import { SITE, THOUGHTS } from '../site.config';
import { getPosts } from '../lib/posts';
const posts = (await getPosts()).slice(0, SITE.recentCount);
const thoughts = THOUGHTS.homeCount > 0 ? (await getPosts('thoughts')).slice(0, THOUGHTS.homeCount) : [];
---
<Base>
  <svg class="cover-defs" aria-hidden="true" focusable="false" width="0" height="0">
    <filter id="cover-ripple" x="-4%" y="-10%" width="108%" height="120%" color-interpolation-filters="sRGB">
      <feTurbulence type="fractalNoise" baseFrequency="0.0022 0.011" numOctaves="2" seed="3" result="noise" />
      <feDisplacementMap in="SourceGraphic" in2="noise" scale="14" xChannelSelector="R" yChannelSelector="G" />
    </filter>
  </svg>
  <section class="journal-cover" aria-labelledby="home-title">
    <img class="cover-landscape" src="/images/mountain-halftone.webp" width="1800" height="680" alt="" fetchpriority="high" />
    <div class="cover-copy">
      <p class="eyebrow"><span class="ink-tick" aria-hidden="true"></span>{SITE.author}的个人记录</p>
      <h1 id="home-title">{SITE.title}</h1>
      {SITE.subtitle && <p class="cover-subtitle">{SITE.subtitle}</p>}
      <p class="cover-description">{SITE.description}</p>
    </div>
    <span class="cover-imprint" aria-hidden="true">CHAORAN / JOURNAL</span>
  </section>
  {thoughts.length > 0 && (
    <section class="home-thoughts" aria-labelledby="thoughts-title">
      <div class="section-heading">
        <h2 id="thoughts-title"><span class="section-number" aria-hidden="true">01</span>最近的想法</h2>
        <a class="text-link" href="/thoughts/">全部想法 <ArrowUpRight size={16} aria-hidden="true" /></a>
      </div>
      <ol class="thought-feed">
        {thoughts.map((p) => <ThoughtCard post={p} />)}
      </ol>
    </section>
  )}
  <section class="recent-posts" aria-labelledby="recent-title">
    <div class="section-heading">
      <h2 id="recent-title"><span class="section-number" aria-hidden="true">02</span>最近</h2>
      <a class="text-link" href="/archive/">全部文章 <ArrowUpRight size={16} aria-hidden="true" /></a>
    </div>
    <div class="cards">
      {posts.map((p) => <PostCard post={p} />)}
      {posts.length === 0 && <p class="intro">这里还什么都没有。</p>}
    </div>
  </section>
</Base>
