---
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';
import { SITE, SECTIONS } from '../site.config';
import { getPosts } from '../lib/posts';
const posts = (await getPosts()).slice(0, SITE.recentCount);
---
<Base>
  <div class="intro">
    <p class="subtitle">『{SITE.subtitle}』</p>
    <p>{SITE.description}</p>
  </div>
  <ul class="sections">
    {Object.entries(SECTIONS).map(([key, s]) => (
      <li><a href={`/${key}/`}><strong>{s.name}</strong><small>{s.description}</small></a></li>
    ))}
  </ul>
  <h2>最近</h2>
  <div class="cards">
    {posts.map((p) => <PostCard post={p} />)}
    {posts.length === 0 && <p class="intro">这里还什么都没有。</p>}
  </div>
  <p class="more"><a href="/archive/">全部文章 →</a></p>
</Base>
