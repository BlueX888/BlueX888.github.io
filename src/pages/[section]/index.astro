---
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import { SECTIONS, SECTION_KEYS, type SectionKey } from '../../site.config';
import { getPosts } from '../../lib/posts';

export async function getStaticPaths() {
  return SECTION_KEYS.map((section) => ({ params: { section } }));
}
const section = Astro.params.section as SectionKey;
const info = SECTIONS[section];
const posts = await getPosts(section);
const years = [...new Set(posts.map((p) => p.data.date.getFullYear()))];
---
<Base title={info.name} description={info.description}>
  <div class="page-title">
    <h1>{info.name}</h1>
    <p>{info.description} · 共 {posts.length} 篇</p>
  </div>
  {years.map((y) => (
    <section>
      {years.length > 1 && <h2 class="year">{y}</h2>}
      <div class="cards">
        {posts.filter((p) => p.data.date.getFullYear() === y).map((p) => <PostCard post={p} />)}
      </div>
    </section>
  ))}
  {posts.length === 0 && <p class="intro">这里还什么都没有。</p>}
</Base>
