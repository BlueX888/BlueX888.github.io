---
import { render } from 'astro:content';
import 'katex/dist/katex.min.css';
import Base from '../../layouts/Base.astro';
import Comments from '../../components/Comments.astro';
import Pageview from '../../components/Pageview.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import { SECTIONS } from '../../site.config';
import { ArrowLeft, ArrowRight } from '@lucide/astro';
import { getPosts, postSlug, postTitle, postUrl, wordCount, excerpt, updatedDate, type Post } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => {
    // 同栏目内的上一篇 / 下一篇
    const same = posts.filter((p) => p.collection === post.collection);
    const idx = same.indexOf(post);
    return {
      params: { section: post.collection, slug: postSlug(post) },
      props: { post, newer: same[idx - 1], older: same[idx + 1] },
    };
  });
}
interface Props { post: Post; newer?: Post; older?: Post }
const { post, newer, older } = Astro.props;
const { Content } = await render(post);
const title = postTitle(post);
const section = SECTIONS[post.collection];
const words = wordCount(post.body);
const updated = updatedDate(post);
---
<Base title={title} description={excerpt(post)} article={{ date: post.data.date, updated }} reading>
  <a class="back-link" href={`/${post.collection}/`}><ArrowLeft size={16} aria-hidden="true" />{section.name}</a>
  <article class="reading-article" data-pagefind-body>
    <header class="article-header">
      <h1>{title}</h1>
      <div class="meta">
        <a href={`/${post.collection}/`} data-pagefind-filter="栏目">{section.name}</a>
        <span>发表于 <FormattedDate date={post.data.date} withYear /></span>
        {updated && <span>修订于 <FormattedDate date={updated} withYear /></span>}
        <span>约 {words} 字</span>
        <Pageview />
        {post.data.draft && <span>草稿</span>}
      </div>
    </header>
    <div class="prose">
      <Content />
    </div>
  </article>
  {(newer || older) && (
    <nav class="post-nav" aria-label="上下篇">
      {older ? <a href={postUrl(older)}><span><ArrowLeft size={14} aria-hidden="true" />较早文章</span>{postTitle(older)}</a> : <span />}
      {newer ? <a class="post-nav-newer" href={postUrl(newer)}><span>较新文章<ArrowRight size={14} aria-hidden="true" /></span>{postTitle(newer)}</a> : <span />}
    </nav>
  )}
  <Comments />
</Base>
