---
import { render } from 'astro:content';
import 'katex/dist/katex.min.css';
import Base from '../../layouts/Base.astro';
import Comments from '../../components/Comments.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import { SECTIONS } from '../../site.config';
import { getPosts, postSlug, postTitle, postUrl, wordCount, excerpt, updatedDate, type Post } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => {
    // 同栏目内的上一篇 / 下一篇
    const same = posts.filter((p) => p.collection === post.collection);
    const idx = same.indexOf(post);
    return {
      params: { section: post.collection, slug: postSlug(post) },
      props: { post, newer: same[idx - 1], older: same[idx + 1] },
    };
  });
}
interface Props { post: Post; newer?: Post; older?: Post }
const { post, newer, older } = Astro.props;
const { Content } = await render(post);
const title = postTitle(post);
const section = SECTIONS[post.collection];
const words = wordCount(post.body);
const updated = updatedDate(post);
---
<Base title={title} description={excerpt(post)} article={{ date: post.data.date, updated }}>
  <article data-pagefind-body>
    <header>
      <h1>{title}</h1>
      <div class="meta">
        <a href={`/${post.collection}/`} data-pagefind-filter="栏目">{section.name}</a>
        <span>发表于 <FormattedDate date={post.data.date} withYear /></span>
        {updated && <span>修订于 <FormattedDate date={updated} withYear /></span>}
        <span>约 {words} 字</span>
        {post.data.draft && <span>草稿</span>}
      </div>
    </header>
    <div class="prose">
      <Content />
    </div>
    {post.data.tags.length > 0 && (
      <div class="tags" style="margin-top:2.5rem">
        {post.data.tags.map((t) => <a class="tag" href={`/tags/${encodeURIComponent(t)}/`} data-pagefind-filter="标签">{t}</a>)}
      </div>
    )}
  </article>
  {(newer || older) && (
    <nav class="post-nav" aria-label="上下篇">
      {older ? <a href={postUrl(older)}><span>上一篇</span>{postTitle(older)}</a> : <span />}
      {newer ? <a href={postUrl(newer)} style="text-align:right"><span>下一篇</span>{postTitle(newer)}</a> : <span />}
    </nav>
  )}
  <Comments />
</Base>
