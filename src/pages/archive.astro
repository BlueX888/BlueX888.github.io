---
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';
import { getPosts, allTags } from '../lib/posts';
const posts = await getPosts();
const tags = allTags(posts);
---
<Base title="归档" description="全部文章">
  <div class="page-title">
    <h1>归档</h1>
    <p>共 {posts.length} 篇</p>
  </div>
  {tags.length > 0 && (
    <div class="tags" style="margin-bottom:2rem">
      {tags.map(([t, n]) => <a class="tag" href={`/tags/${encodeURIComponent(t)}/`}>{t} <small>{n}</small></a>)}
    </div>
  )}
  <PostList posts={posts} groupByYear showSection />
</Base>
