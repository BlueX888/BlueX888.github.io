---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Comments from '../../components/Comments.astro';
import Pageview from '../../components/Pageview.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import { ArrowLeft, ArrowRight } from '@lucide/astro';
import { getPosts, postSlug, postTitle, postUrl, updatedDate, type Post } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPosts('thoughts');
  return posts.map((post) => {
    const idx = posts.indexOf(post);
    return {
      params: { slug: postSlug(post) },
      props: { post, newer: posts[idx - 1], older: posts[idx + 1] },
    };
  });
}
interface Props { post: Post; newer?: Post; older?: Post }
const { post, newer, older } = Astro.props;
const { Content } = await render(post);
const updated = updatedDate(post);
---
<Base title={postTitle(post)} description={postTitle(post)} article={{ date: post.data.date, updated }} reading>
  <a class="back-link" href="/thoughts/"><ArrowLeft size={16} aria-hidden="true" />想法</a>
  <article class="reading-article thought-article" data-pagefind-body>
    <div class="prose">
      <Content />
    </div>
    <footer class="meta thought-meta">
      <FormattedDate date={post.data.date} withYear />
      {updated && <span>修订于 <FormattedDate date={updated} withYear /></span>}
      <Pageview />
      {post.data.draft && <span>草稿</span>}
    </footer>
  </article>
  {(newer || older) && (
    <nav class="post-nav" aria-label="上下条">
      {older ? <a href={postUrl(older)}><span><ArrowLeft size={14} aria-hidden="true" />更早</span>{postTitle(older)}</a> : <span />}
      {newer ? <a class="post-nav-newer" href={postUrl(newer)}><span>更新<ArrowRight size={14} aria-hidden="true" /></span>{postTitle(newer)}</a> : <span />}
    </nav>
  )}
  <Comments />
</Base>
